// Blue noise in [0, 1) for a pixel; the golden-ratio shift per frame keeps successive frames
// decorrelated while each frame stays a blue noise pattern
float blueNoise(const uint2 pixelIdx, const uint frameNumber)
{
    const uint2 p = pixelIdx & (BLUE_NOISE_TILE_SIZE - 1u);
    const uint texelIdx = p.y * BLUE_NOISE_TILE_SIZE + p.x;
    const uint rank = (blueNoiseTile[texelIdx >> 2] >> ((texelIdx & 3u) * 8u)) & 0xFFu;
    return frac((float(rank) + 0.5f) / 256.f + float(frameNumber) * 0.61803398875f);
}
