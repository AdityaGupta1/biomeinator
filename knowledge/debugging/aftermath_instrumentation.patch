diff --git a/src/rendering/renderer/aftermath.cpp b/src/rendering/renderer/aftermath.cpp
new file mode 100644
index 0000000..cfbea42
--- /dev/null
+++ b/src/rendering/renderer/aftermath.cpp
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2025-2026 Aditya Gupta
+
+#include "aftermath.h"
+
+#include "logger.h"
+#include "settings_manager.h"
+
+#if ENABLE_AFTERMATH
+
+#include "util/file_util.h"
+
+#include <GFSDK_Aftermath.h>
+#include <GFSDK_Aftermath_GpuCrashDump.h>
+#include <GFSDK_Aftermath_GpuCrashDumpDecoding.h>
+
+#include <algorithm>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace Aftermath
+{
+
+namespace
+{
+
+bool enabled = false;
+GFSDK_Aftermath_ContextHandle contextHandle = nullptr;
+
+// The crash dump and shader debug info callbacks are invoked from driver threads.
+std::mutex dumpMutex;
+std::filesystem::path dumpDir;
+std::string dumpNamePrefix;
+uint32_t numDumpsWritten = 0;
+
+// A resource's VA range and name are captured up front and outlive the resource itself,
+// because the interesting case is a fault against memory that has already been released.
+// The raw pointer is a lookup key only and is never dereferenced.
+struct TrackedResource
+{
+    const ID3D12Resource* key;
+    D3D12_GPU_VIRTUAL_ADDRESS gpuVaStart;
+    uint64_t sizeBytes;
+    std::wstring name;
+    uint32_t createOrdinal;
+    uint32_t freeOrdinal; // freeOrdinalAlive while the resource has not been scheduled for deletion
+};
+
+constexpr uint32_t freeOrdinalAlive = UINT32_MAX;
+
+// Well above the few hundred buffers a session creates; only here so a runaway allocation
+// loop cannot turn the tracker itself into the failure.
+constexpr size_t maxTrackedResources = 65536;
+
+std::mutex trackerMutex;
+std::vector<TrackedResource> trackedResources;
+uint32_t nextOrdinal = 0;
+
+void writeBlob(const std::filesystem::path& path, const void* data, uint32_t sizeBytes)
+{
+    std::ofstream file(path, std::ios::out | std::ios::binary);
+    if (!file)
+    {
+        Logger::logError("Failed to open %s for writing", path.string().c_str());
+        return;
+    }
+
+    file.write(static_cast<const char*>(data), sizeBytes);
+}
+
+// Aftermath's own page-fault report only names a resource it still has tracking data for,
+// and comes back empty for the wild-pointer case. This table covers both, and survives the
+// resource's destruction.
+void writeResourceTable(const std::filesystem::path& path)
+{
+    std::vector<TrackedResource> snapshot;
+    {
+        const std::lock_guard<std::mutex> lock(trackerMutex);
+        snapshot = trackedResources;
+    }
+
+    std::sort(snapshot.begin(), snapshot.end(), [](const TrackedResource& a, const TrackedResource& b) {
+        return a.gpuVaStart < b.gpuVaStart;
+    });
+
+    std::wofstream file(path);
+    if (!file)
+    {
+        Logger::logError("Failed to open %s for writing", path.string().c_str());
+        return;
+    }
+
+    file << L"status  gpuVaStart         gpuVaEnd           sizeBytes   created  freed  name\n";
+    for (const TrackedResource& tracked : snapshot)
+    {
+        const bool isAlive = (tracked.freeOrdinal == freeOrdinalAlive);
+
+        file << (isAlive ? L"live    " : L"FREED   ") << std::hex << L"0x" << tracked.gpuVaStart << L" 0x"
+             << (tracked.gpuVaStart + tracked.sizeBytes) << std::dec << L" " << tracked.sizeBytes << L" "
+             << tracked.createOrdinal << L" ";
+
+        if (isAlive)
+        {
+            file << L"-";
+        }
+        else
+        {
+            file << tracked.freeOrdinal;
+        }
+
+        file << L" " << tracked.name << L"\n";
+    }
+}
+
+void GFSDK_AFTERMATH_CALL onCrashDump(const void* dump, const uint32_t sizeBytes, void* /*userData*/)
+{
+    const std::lock_guard<std::mutex> lock(dumpMutex);
+
+    const std::string baseName = dumpNamePrefix + "-" + std::to_string(numDumpsWritten++);
+
+    const std::filesystem::path path = dumpDir / (baseName + ".nv-gpudmp");
+    writeBlob(path, dump, sizeBytes);
+
+    writeResourceTable(dumpDir / (baseName + ".buffers.txt"));
+
+    Logger::logError("Wrote GPU crash dump: %s", path.string().c_str());
+}
+
+void GFSDK_AFTERMATH_CALL onShaderDebugInfo(const void* debugInfo, const uint32_t sizeBytes, void* /*userData*/)
+{
+    // The identifier is how the Nsight UI matches this blob back to a shader in the dump,
+    // so it has to be the file name.
+    GFSDK_Aftermath_ShaderDebugInfoIdentifier identifier{};
+    const GFSDK_Aftermath_Result result =
+        GFSDK_Aftermath_GetShaderDebugInfoIdentifier(GFSDK_Aftermath_Version_API, debugInfo, sizeBytes, &identifier);
+    if (!GFSDK_Aftermath_SUCCEED(result))
+    {
+        Logger::logError("GFSDK_Aftermath_GetShaderDebugInfoIdentifier failed (0x%08X)",
+                         static_cast<uint32_t>(result));
+        return;
+    }
+
+    char fileName[64];
+    sprintf_s(fileName, "shader-%016llX%016llX.nvdbg", identifier.id[0], identifier.id[1]);
+
+    const std::lock_guard<std::mutex> lock(dumpMutex);
+    writeBlob(dumpDir / fileName, debugInfo, sizeBytes);
+}
+
+void GFSDK_AFTERMATH_CALL onDescription(PFN_GFSDK_Aftermath_AddGpuCrashDumpDescription addValue, void* /*userData*/)
+{
+    // The command line identifies which golden test was running when a stress loop hangs.
+    static const std::string cmdLine =
+        std::string(GetCommandLineA()).substr(0, GFSDK_Aftermath_MAX_STRING_LENGTH);
+
+    addValue(GFSDK_Aftermath_GpuCrashDumpDescriptionKey_ApplicationName, "Biomeinator");
+    addValue(GFSDK_Aftermath_GpuCrashDumpDescriptionKey_UserDefined, cmdLine.c_str());
+}
+
+} // namespace
+
+void enableCrashDumps()
+{
+    if (!SettingsManager::getAsBool("aftermath"))
+    {
+        return;
+    }
+
+    if (SettingsManager::getAsBool("gpuValidation"))
+    {
+        Logger::logError("--aftermath cannot be combined with --gpuValidation: Aftermath refuses to initialize "
+                         "alongside the D3D12 debug layer");
+        exit(1);
+    }
+
+    dumpDir = FileUtil::getDocumentsDir("gpu_crash_dumps");
+    dumpNamePrefix = FileUtil::getTimestampString() + "-" + std::to_string(GetCurrentProcessId());
+
+    const GFSDK_Aftermath_Result result = GFSDK_Aftermath_EnableGpuCrashDumps(
+        GFSDK_Aftermath_Version_API,
+        GFSDK_Aftermath_GpuCrashDumpWatchedApiFlags_DX,
+        // Deferring the shader debug info callbacks means a run that never crashes writes
+        // no files at all, which matters when stress-looping the golden suite.
+        GFSDK_Aftermath_GpuCrashDumpFeatureFlags_DeferDebugInfoCallbacks,
+        onCrashDump,
+        onShaderDebugInfo,
+        onDescription,
+        nullptr /*resolveMarkerCb*/,
+        nullptr /*userData*/);
+
+    if (!GFSDK_Aftermath_SUCCEED(result))
+    {
+        Logger::logError("GFSDK_Aftermath_EnableGpuCrashDumps failed (0x%08X), crash dumps disabled",
+                         static_cast<uint32_t>(result));
+        return;
+    }
+
+    enabled = true;
+}
+
+void initDevice(ID3D12Device* device)
+{
+    if (!enabled)
+    {
+        return;
+    }
+
+    // CallStackCapturing gives each marker a CPU callstack, which is what turns a hung
+    // dispatch into a source location without hand-placing a marker on every pass.
+    const uint32_t featureFlags = GFSDK_Aftermath_FeatureFlags_EnableMarkers |
+                                  GFSDK_Aftermath_FeatureFlags_EnableResourceTracking |
+                                  GFSDK_Aftermath_FeatureFlags_CallStackCapturing |
+                                  GFSDK_Aftermath_FeatureFlags_GenerateShaderDebugInfo |
+                                  GFSDK_Aftermath_FeatureFlags_EnableShaderErrorReporting;
+
+    const GFSDK_Aftermath_Result result =
+        GFSDK_Aftermath_DX12_Initialize(GFSDK_Aftermath_Version_API, featureFlags, device);
+    if (!GFSDK_Aftermath_SUCCEED(result))
+    {
+        Logger::logError("GFSDK_Aftermath_DX12_Initialize failed (0x%08X), crash dumps disabled",
+                         static_cast<uint32_t>(result));
+        enabled = false;
+        return;
+    }
+
+    Logger::log("Aftermath crash dumps enabled, output dir: %s", dumpDir.string().c_str());
+}
+
+void initCmdList(ID3D12GraphicsCommandList4* cmdList)
+{
+    if (!enabled)
+    {
+        return;
+    }
+
+    const GFSDK_Aftermath_Result result = GFSDK_Aftermath_DX12_CreateContextHandle(cmdList, &contextHandle);
+    if (!GFSDK_Aftermath_SUCCEED(result))
+    {
+        Logger::logError("GFSDK_Aftermath_DX12_CreateContextHandle failed (0x%08X), markers disabled",
+                         static_cast<uint32_t>(result));
+        contextHandle = nullptr;
+    }
+}
+
+void setMarker(const char* name)
+{
+    if (contextHandle == nullptr)
+    {
+        return;
+    }
+
+    GFSDK_Aftermath_SetEventMarker(contextHandle, name, static_cast<uint32_t>(strlen(name) + 1));
+}
+
+void trackResource(ID3D12Resource* resource, const wchar_t* name)
+{
+    if (!enabled)
+    {
+        return;
+    }
+
+    {
+        const std::lock_guard<std::mutex> lock(trackerMutex);
+
+        // Buffer creation is tracked centrally, before the caller has had a chance to name
+        // the resource; a later call for the same resource is that name arriving.
+        const auto existing = std::find_if(trackedResources.rbegin(), trackedResources.rend(),
+                                           [resource](const TrackedResource& candidate) {
+                                               return candidate.key == resource &&
+                                                      candidate.freeOrdinal == freeOrdinalAlive;
+                                           });
+        if (existing != trackedResources.rend())
+        {
+            existing->name = name;
+            return;
+        }
+
+        if (trackedResources.size() >= maxTrackedResources)
+        {
+            return;
+        }
+
+        trackedResources.push_back({
+            .key = resource,
+            .gpuVaStart = resource->GetGPUVirtualAddress(),
+            .sizeBytes = resource->GetDesc().Width,
+            .name = name,
+            .createOrdinal = nextOrdinal++,
+            .freeOrdinal = freeOrdinalAlive,
+        });
+    }
+
+    GFSDK_Aftermath_ResourceHandle handle{};
+    const GFSDK_Aftermath_Result result = GFSDK_Aftermath_DX12_RegisterResource(resource, &handle);
+    if (!GFSDK_Aftermath_SUCCEED(result))
+    {
+        static bool didLogFailure = false;
+        if (!didLogFailure)
+        {
+            Logger::logError("GFSDK_Aftermath_DX12_RegisterResource failed (0x%08X), page faults will not name "
+                             "the offending resource",
+                             static_cast<uint32_t>(result));
+            didLogFailure = true;
+        }
+    }
+}
+
+void noteResourceFreed(ID3D12Resource* resource)
+{
+    if (!enabled)
+    {
+        return;
+    }
+
+    const std::lock_guard<std::mutex> lock(trackerMutex);
+
+    // Search backwards: a buffer that grows repeatedly reuses the same pointer value, and
+    // the most recent record is the one being retired.
+    const auto tracked = std::find_if(trackedResources.rbegin(), trackedResources.rend(),
+                                      [resource](const TrackedResource& candidate) {
+                                          return candidate.key == resource &&
+                                                 candidate.freeOrdinal == freeOrdinalAlive;
+                                      });
+    if (tracked != trackedResources.rend())
+    {
+        tracked->freeOrdinal = nextOrdinal++;
+    }
+}
+
+void waitForCrashDump()
+{
+    if (!enabled)
+    {
+        return;
+    }
+
+    // The fence timeout is shorter than the TDR delay, so on entry the driver has usually
+    // not even noticed the hang yet — poll well past both before giving up.
+    constexpr uint32_t pollIntervalMs = 50;
+    constexpr uint32_t timeoutMs = 5000;
+
+    GFSDK_Aftermath_CrashDump_Status status = GFSDK_Aftermath_CrashDump_Status_Unknown;
+    for (uint32_t elapsedMs = 0; elapsedMs < timeoutMs; elapsedMs += pollIntervalMs)
+    {
+        const GFSDK_Aftermath_Result result = GFSDK_Aftermath_GetCrashDumpStatus(&status);
+        if (!GFSDK_Aftermath_SUCCEED(result))
+        {
+            Logger::logError("GFSDK_Aftermath_GetCrashDumpStatus failed (0x%08X)", static_cast<uint32_t>(result));
+            return;
+        }
+
+        if (status == GFSDK_Aftermath_CrashDump_Status_Finished ||
+            status == GFSDK_Aftermath_CrashDump_Status_CollectingDataFailed)
+        {
+            break;
+        }
+
+        Sleep(pollIntervalMs);
+    }
+
+    if (status != GFSDK_Aftermath_CrashDump_Status_Finished)
+    {
+        Logger::logError("Aftermath produced no crash dump (status: %u)", static_cast<uint32_t>(status));
+    }
+}
+
+void destroy()
+{
+    if (!enabled)
+    {
+        return;
+    }
+
+    if (contextHandle != nullptr)
+    {
+        GFSDK_Aftermath_ReleaseContextHandle(contextHandle);
+        contextHandle = nullptr;
+    }
+
+    GFSDK_Aftermath_DisableGpuCrashDumps();
+    enabled = false;
+}
+
+} // namespace Aftermath
+
+#else
+
+namespace Aftermath
+{
+
+void enableCrashDumps()
+{
+    if (SettingsManager::getAsBool("aftermath"))
+    {
+        Logger::logError("--aftermath requires the Nsight Aftermath SDK, which was not found at configure time");
+        exit(1);
+    }
+}
+
+void initDevice(ID3D12Device* /*device*/)
+{
+}
+
+void initCmdList(ID3D12GraphicsCommandList4* /*cmdList*/)
+{
+}
+
+void setMarker(const char* /*name*/)
+{
+}
+
+void trackResource(ID3D12Resource* /*resource*/, const wchar_t* /*name*/)
+{
+}
+
+void noteResourceFreed(ID3D12Resource* /*resource*/)
+{
+}
+
+void waitForCrashDump()
+{
+}
+
+void destroy()
+{
+}
+
+} // namespace Aftermath
+
+#endif
