--- /dev/null
+++ b/src/rendering/renderer/aftermath.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2025-2026 Aditya Gupta
+
+#pragma once
+
+#include "rendering/dxr_includes.h"
+
+// GPU crash dump collection via Nsight Aftermath, for diagnosing GPU hangs that DRED
+// breadcrumbs can only localize to a command-list position. Every entry point is a no-op
+// unless --aftermath is set, and the whole module compiles out when CMake could not find
+// the Aftermath SDK.
+namespace Aftermath
+{
+
+// Must run before device creation.
+void enableCrashDumps();
+
+void initDevice(ID3D12Device* device);
+void initCmdList(ID3D12GraphicsCommandList4* cmdList);
+
+// Names the enclosing pass in the crash dump. Not for high-frequency call sites — each
+// marker is a driver call plus a payload copy.
+void setMarker(const char* name);
+
+// Records a buffer's GPU VA range under `name` and registers it with Aftermath, so a page
+// fault can be attributed to it. Call after ID3D12Object::SetName — that ordering is what
+// lets Aftermath pick up the debug name. Records are deliberately never dropped: the whole
+// point is to still recognize a resource that has since been destroyed.
+void trackResource(ID3D12Resource* resource, const wchar_t* name);
+
+// Marks a tracked buffer as scheduled for destruction, so the dumped table can distinguish
+// a fault in live memory from a use-after-free.
+void noteResourceFreed(ID3D12Resource* resource);
+
+// Blocks until the driver finishes generating a crash dump, or times out. Call from the
+// hang-detection path before tearing anything down.
+void waitForCrashDump();
+
+void destroy();
+
+} // namespace Aftermath
