+#include "terrain/block.h"
+#include <fstream>
+#include <json.hpp>
+uint32_t benchmarkSeed;
+namespace SettingsManager { uint32_t getWorldSeed() { return benchmarkSeed; } }
+static std::array<BlockData, static_cast<size_t>(Block::COUNT)> blockDatas;
+namespace Blocks { const BlockData& getBlockData(Block block) { return blockDatas[static_cast<size_t>(block)]; } }
+void initBenchmarkBlocks()
+{
+    for (size_t i = 0; i < Blocks::blockIdNames.size(); ++i)
+    {
+        std::ifstream file(std::filesystem::path("assets/blocks") / (std::string(Blocks::blockIdNames[i]) + ".json"));
+        const auto json = nlohmann::json::parse(file);
+        const auto type = json.value("type", "solid");
+        blockDatas[i].type = type == "air" ? BlockType::AIR : type == "water" ? BlockType::WATER :
+            type == "transparent_cutout" ? BlockType::TRANSPARENT_CUTOUT : type == "glass" ? BlockType::GLASS : BlockType::SOLID;
+        const auto shape = json.value("shape", "cube");
+        blockDatas[i].shape = shape == "decorator_custom" ? BlockShape::DECORATOR_CUSTOM :
+            shape == "x_shaped" ? BlockShape::X_SHAPED : shape == "liquid_top" ? BlockShape::LIQUID_TOP : BlockShape::CUBE;
+        if (json.value("blockState", "none") == "surface_mount") blockDatas[i].stateKind = BlockStateKind::SURFACE_MOUNT;
+        blockDatas[i].markAsEmitter = json.value("markAsEmitter", false);
+    }
+}
