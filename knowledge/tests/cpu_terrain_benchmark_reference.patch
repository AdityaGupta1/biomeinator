+// Actual generation, immutable masks, structures and decorators, with engine startup omitted.
+#include "terrain/chunk.h"
+#include "terrain/chunk_generator.h"
+#include "multithreading/thread_memory_allocator.h"
+#include <chrono>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <set>
+#include <json.hpp>
+
+struct Timings { double columns{}, terrain{}, worley{}, simplex{}, materials{}, fill{}, structures{}, decorators{}; } timings;
+#ifdef BENCH_VERIFY
+static bool verifyCandidates=false;
+static std::vector<uint32_t> verifiedCandidates;
+#endif
+using Clock = std::chrono::steady_clock;
+static double elapsed(Clock::time_point start) { return std::chrono::duration<double, std::milli>(Clock::now()-start).count(); }
+#include "terrain/generator.cpp"
+#include "terrain/chunk_methods.cpp"
+
+template<typename Tag, typename Tag::Type member> struct Access
+{ friend typename Tag::Type access(Tag) { return member; } };
+#define FIELD_ACCESS(name, ...) \
+    struct name##Tag { using Type = __VA_ARGS__ Chunk::*; friend Type access(name##Tag); }; \
+    template struct Access<name##Tag, &Chunk::name>;
+FIELD_ACCESS(blocks, std::vector<Block>)
+FIELD_ACCESS(biomes, std::vector<Biome>)
+FIELD_ACCESS(terrainTopY, std::vector<uint16_t>)
+FIELD_ACCESS(structures, std::vector<Structure>)
+FIELD_ACCESS(caveStructures, std::vector<CaveStructure>)
+FIELD_ACCESS(blockStates, std::unordered_map<uint32_t,uint8_t>)
+FIELD_ACCESS(structureNeighbors, std::vector<const Chunk*>)
+FIELD_ACCESS(neighbors, std::array<Chunk*,4>)
+#ifdef BENCH_GROUPED
+FIELD_ACCESS(caveDecoration, CaveDecorationData)
+#else
+FIELD_ACCESS(caveAirMask, std::vector<uint64_t>)
+FIELD_ACCESS(caveBiomeNoise, std::vector<float>)
+FIELD_ACCESS(caveBiomeSurfaceBias, std::vector<CaveBiomeNoise>)
+FIELD_ACCESS(caveBiomeNoiseHeight, uint32_t)
+#endif
+struct FillTag { using Type = void (Chunk::*)(ThreadMemoryAllocator&); friend Type access(FillTag); };
+template struct Access<FillTag, &Chunk::fillTerrainBlocksAndCreateStructures>;
+struct MasksTag { using Type = void (Chunk::*)(); friend Type access(MasksTag); };
+template struct Access<MasksTag, &Chunk::buildTerrainAirMask>;
+struct DecorateTag { using Type = void (Chunk::*)(); friend Type access(DecorateTag); };
+template struct Access<DecorateTag, &Chunk::runStructuresAndDecoratorPass>;
+Chunk::Chunk(glm::ivec2 pos, Region* region) : chunkPos(pos), region(region) {}
+extern uint32_t benchmarkSeed;
+void initBenchmarkBlocks();
+
+struct MetadataView
+{
+    std::vector<uint64_t>& airMask;
+    std::vector<float>& noise;
+    std::vector<CaveBiomeNoise>& bias;
+    uint32_t& height;
+};
+static MetadataView metadata(Chunk& chunk)
+{
+#ifdef BENCH_GROUPED
+    auto& data = chunk.*access(caveDecorationTag{});
+    return {data.airMask,data.noise,data.surfaceBias,data.noiseHeight};
+#else
+    return {chunk.*access(caveAirMaskTag{}),chunk.*access(caveBiomeNoiseTag{}),
+            chunk.*access(caveBiomeSurfaceBiasTag{}),chunk.*access(caveBiomeNoiseHeightTag{})};
+#endif
+}
+
+static void prepare(Chunk& chunk)
+{
+    (chunk.*access(blocksTag{})).assign(numChunkBlocks, Block::AIR);
+    (chunk.*access(biomesTag{})).resize(chunkSizeXZSquare);
+    (chunk.*access(terrainTopYTag{})).assign(chunkSizeXZSquare,0);
+    (chunk.*access(structuresTag{})).clear();
+    (chunk.*access(caveStructuresTag{})).clear();
+    (chunk.*access(blockStatesTag{})).clear();
+#ifdef BENCH_GROUPED
+    (chunk.*access(caveDecorationTag{})).prepare();
+#else
+    metadata(chunk).airMask.assign((chunkSizeXZSquare*caveMaxY+63)/64,0);
+    metadata(chunk).bias.resize(chunkSizeXZSquare);
+#endif
+}
+
+static size_t retainedBytes(Chunk& chunk)
+{
+    return metadata(chunk).airMask.size()*8 + metadata(chunk).noise.size()*4 +
+        metadata(chunk).bias.size()*sizeof(CaveBiomeNoise);
+}
+
+static void release(Chunk& chunk)
+{
+#ifdef BENCH_GROUPED
+    (chunk.*access(caveDecorationTag{})).release();
+#else
+    std::vector<uint64_t>().swap(metadata(chunk).airMask);
+    std::vector<float>().swap(metadata(chunk).noise);
+    std::vector<CaveBiomeNoise>().swap(metadata(chunk).bias);
+    metadata(chunk).height = 0;
+#endif
+#ifdef BENCH_VERIFY
+    const auto data = metadata(chunk);
+    if (data.airMask.capacity() || data.noise.capacity() || data.bias.capacity() || data.height)
+        throw std::runtime_error("retained cave data was not released");
+#endif
+}
+
+// Snapshot all original cave-air IDs, including interiors, outside the timing window.
+// Deferred IDs are reconstructed only here to verify the retained data exactly.
+static std::vector<uint8_t> caveIds(Chunk& chunk)
+{
+    std::vector<uint8_t> ids(chunkSizeXZSquare*caveMaxY,0xff);
+    const auto& mask = metadata(chunk).airMask;
+    const auto& fields = metadata(chunk).noise;
+    const auto& bias = metadata(chunk).bias;
+    const uint height = metadata(chunk).height;
+    const uint size = chunkSizeXZ/CaveBiomeFields::downsample+1;
+    for (uint z=0;z<chunkSizeXZ;++z) for (uint x=0;x<chunkSizeXZ;++x)
+    {
+        const uint col=x+chunkSizeXZ*z;
+        CaveBiomeFields::Column t(fields.data(),size,height,x,z), h(fields.data()+size*size*height,size,height,x,z);
+        for (uint y=0;y<caveMaxY;++y)
+        {
+            const uint index=col*caveMaxY+y;
+            if ((mask[index/64] >> (index%64)) & 1)
+                ids[index] = static_cast<uint8_t>(CaveBiomes::getClosestCaveBiome({t.sample(y)+bias[col].temperature,h.sample(y)+bias[col].humidity}));
+        }
+    }
+    return ids;
+}
+
+static void verifyGrids()
+{
+    VERIFY_GRIDS
+}
+
+#include "fixtures.cpp"
+
+template<class T> void writeVector(std::ofstream& file,const std::vector<T>& data)
+{ file.write(reinterpret_cast<const char*>(data.data()),data.size()*sizeof(T)); }
+
+int main(int argc,char** argv)
+{
+    if (argc<3) return 2;
+    const std::filesystem::path output(argv[1]);
+    const int repeats=std::stoi(argv[2]);
+    const bool snapshot=argc>3 && std::string(argv[3])=="snapshot";
+    std::filesystem::create_directories(output);
+    initBenchmarkBlocks(); Biomes::init(); CaveBiomes::init(); Structures::init(); CaveStructures::init();
+    if(argc>3 && std::string(argv[3])=="fixtures") { syntheticFixtures(output); return 0; }
+    std::ofstream csv(output/"timings.csv");
+    csv << "seed,x,z,biome,iteration,prepare_ms,generation_ms,masks_ms,structures_ms,decorators_ms,release_ms,total_ms,retained_bytes\n" << std::setprecision(9);
+    std::ofstream before,after,heights,caves,states,candidates,manifest;
+    if(snapshot)
+    {
+        before.open(output/"before.bin",std::ios::binary); after.open(output/"after.bin",std::ios::binary);
+        heights.open(output/"heights.bin",std::ios::binary); caves.open(output/"cave_ids.bin",std::ios::binary);
+        states.open(output/"states.jsonl"); candidates.open(output/"candidates.jsonl");
+        manifest.open(output/"chunks.csv"); manifest<<"seed,x,z,biome\n";
+    }
+    ThreadMemoryAllocator scratch;
+    uint64_t checksum=0;
+    for (const uint32_t seed : {1738u,42u,2026u,987654u})
+    {
+        if(const char* requested=std::getenv("TERRAIN_BENCH_SEED"); requested && seed!=std::stoul(requested)) continue;
+        benchmarkSeed=seed; ChunkGenerator::init(); verifyGrids();
+        std::array<bool,static_cast<size_t>(Biome::COUNT)> found{};
+        struct Location { glm::ivec2 pos; Biome biome; };
+        std::vector<Location> locations;
+        for(int z=-8192;z<=8192;z+=128)
+        {
+            for(int x=-8192;x<=8192;x+=128)
+            {
+                const Biome biome=BiomeNoiseFields::biomeFromNoise(BiomeNoiseFields::sampleAt(glm::vec2(x,z)));
+                if(found[static_cast<size_t>(biome)]) continue;
+                found[static_cast<size_t>(biome)]=true;
+                for(int dz=0;dz<2;++dz) for(int dx=0;dx<2;++dx) locations.push_back({{x/16+dx,z/16+dz},biome});
+            }
+            if(std::all_of(found.begin(),found.end(),[](bool value){return value;})) break;
+        }
+        for(auto pos : {glm::ivec2(0,0),glm::ivec2(-1,-1),glm::ivec2(0,-1),glm::ivec2(-1,0)})
+            locations.push_back({pos,BiomeNoiseFields::biomeFromNoise(BiomeNoiseFields::sampleAt(glm::vec2(pos*16)))});
+        using Key=std::pair<int,int>;
+        std::map<Key,std::unique_ptr<Chunk>> chunks;
+        for(const auto& location:locations) for(int dz=-1;dz<=1;++dz) for(int dx=-1;dx<=1;++dx)
+        {
+            const glm::ivec2 pos=location.pos+glm::ivec2(dx,dz);
+            chunks.try_emplace({pos.x,pos.y},std::make_unique<Chunk>(pos,nullptr));
+        }
+        for(const auto& location:locations)
+        {
+            auto& chunk=*chunks.at({location.pos.x,location.pos.y});
+            auto& neighborhood=chunk.*access(structureNeighborsTag{});
+            for(int dz=-1;dz<=1;++dz) for(int dx=-1;dx<=1;++dx)
+                neighborhood.push_back(chunks.at({location.pos.x+dx,location.pos.y+dz}).get());
+            for(uint d=0;d<4;++d)
+            {
+                const auto offset=neighborOffset(static_cast<NeighborDirection>(d));
+                (chunk.*access(neighborsTag{}))[d]=chunks.at({location.pos.x+offset.x,location.pos.y+offset.y}).get();
+            }
+        }
+        for(int iteration=-1;iteration<repeats;++iteration)
+        {
+            struct Generation { double prepare,fill,masks; size_t bytes; };
+            std::map<Key,Generation> times;
+            for(auto& [key,pointer]:chunks)
+            {
+                auto& chunk=*pointer; scratch.clear(); timings={};
+                auto start=Clock::now(); prepare(chunk); const double prep=elapsed(start);
+                start=Clock::now(); (chunk.*access(FillTag{}))(scratch); const double gen=elapsed(start);
+                start=Clock::now(); (chunk.*access(MasksTag{}))(); const double masks=elapsed(start);
+                times[key]={prep,gen,masks,retainedBytes(chunk)};
+            }
+            for(const auto& location:locations)
+            {
+                auto& chunk=*chunks.at({location.pos.x,location.pos.y});
+                if(snapshot&&iteration==0)
+                {
+                    writeVector(before,chunk.*access(blocksTag{})); writeVector(heights,chunk.*access(terrainTopYTag{})); writeVector(caves,caveIds(chunk));
+                    manifest<<seed<<','<<location.pos.x<<','<<location.pos.y<<','<<static_cast<int>(location.biome)<<'\n';
+                    nlohmann::json items={{"surface",nlohmann::json::array()},{"cave",nlohmann::json::array()}};
+                    for(const auto& s:chunk.*access(structuresTag{})) items["surface"].push_back({static_cast<int>(s.type),s.pos_WS.x,s.pos_WS.y,s.pos_WS.z});
+                    for(const auto& s:chunk.*access(caveStructuresTag{})) items["cave"].push_back({static_cast<int>(s.type),s.pos_WS.x,s.pos_WS.y,s.pos_WS.z,s.availableHeight});
+                    candidates<<items.dump()<<'\n';
+                }
+                timings={}; (chunk.*access(DecorateTag{}))();
+                const auto& data=chunk.*access(blocksTag{});
+                if(iteration>=0) for(uint i=0;i<numChunkBlocks;i+=97) checksum=checksum*31+static_cast<BlockId>(data[i]);
+                if(snapshot&&iteration==0)
+                {
+                    writeVector(after,data);
+                    std::map<uint32_t,uint8_t> ordered;
+                    for(auto [index,state]:chunk.*access(blockStatesTag{})) ordered[index]=state;
+                    nlohmann::json items=nlohmann::json::array();
+                    for(auto [index,state]:ordered) items.push_back({index,state});
+                    states<<items.dump()<<'\n';
+                }
+                const auto start=Clock::now(); release(chunk); const double cleanup=elapsed(start);
+                const auto& t=times.at({location.pos.x,location.pos.y});
+                if(iteration>=0)
+                    csv<<seed<<','<<location.pos.x<<','<<location.pos.y<<','<<static_cast<int>(location.biome)<<','<<iteration<<','
+                       <<t.prepare<<','<<t.fill<<','<<t.masks<<','<<timings.structures<<','<<timings.decorators<<','<<cleanup<<','
+                       <<t.prepare+t.fill+t.masks+timings.structures+timings.decorators+cleanup<<','<<t.bytes<<'\n';
+            }
+            // Halo chunks only supply immutable terrain and candidate lists. Their fields are
+            // released too, so each iteration starts with the production allocation lifecycle.
+            for(auto& [key,pointer]:chunks) release(*pointer);
+        }
+        std::cout<<"seed="<<seed<<" targets="<<locations.size()<<" generated_with_halo="<<chunks.size()<<'\n'<<std::flush;
+    }
+    std::cout<<"checksum="<<checksum<<'\n';
+}
