@@ -0,0 +1,35 @@
+from pathlib import Path
+import csv,json,os,statistics,subprocess
+
+work=Path(__file__).resolve().parent
+variants=['baseline','surface','directional','combined']
+seeds=[1738,42,2026,987654]
+results=work/'results'
+for run in range(3):
+    for seed_index,seed in enumerate(seeds):
+        shift=(run+seed_index)%len(variants)
+        order=variants[shift:]+variants[:shift]
+        if run%2: order=list(reversed(order))
+        for variant in order:
+            print(f'run={run} seed={seed} variant={variant}',flush=True)
+            env=dict(os.environ);env['TERRAIN_BENCH_SEED']=str(seed)
+            subprocess.run([str(work/variant/'benchmark.exe'),str(results/variant/str(run)/str(seed)),'5'],env=env,check=True,timeout=60)
+summary={}
+for variant in variants:
+    rows=[]
+    for filename in (results/variant).rglob('timings.csv'): rows.extend(csv.DictReader(filename.open()))
+    fields=['prepare_ms','generation_ms','masks_ms','structures_ms','decorators_ms','release_ms','total_ms','retained_bytes']
+    summary[variant]={'samples':len(rows),'means':{field:statistics.mean(float(row[field]) for row in rows) for field in fields}}
+    summary[variant]['by_biome']={biome:statistics.mean(float(row['total_ms']) for row in rows if row['biome']==biome) for biome in sorted({row['biome'] for row in rows})}
+    paired=[]
+    for run in range(3):
+        for seed in seeds:
+            means=[]
+            for case in ['baseline',variant]:
+                rows=list(csv.DictReader((results/case/str(run)/str(seed)/'timings.csv').open()))
+                means.append(statistics.mean(float(row['total_ms']) for row in rows))
+            paired.append(100*(means[1]/means[0]-1))
+    summary[variant]['pair_changes_percent']=paired
+(results/'summary.json').write_text(json.dumps(summary,indent=2))
+print(json.dumps(summary,indent=2))
+
diff --git a/build/terrain_cleanup_perf/verify.py b/build/terrain_cleanup_perf/verify.py
new file mode 100644
--- /dev/null
+++ b/build/terrain_cleanup_perf/verify.py
@@ -0,0 +1,24 @@
+from pathlib import Path
+import hashlib,json,subprocess
+
+work=Path(__file__).resolve().parent
+variants=['baseline','surface','directional','combined']
+for variant in variants:
+    subprocess.run([str(work/variant/'benchmark.exe'),str(work/'verification'/variant),'1','snapshot'],check=True,timeout=60)
+for variant in ['baseline_verify','combined_verify']:
+    subprocess.run([str(work/variant/'benchmark.exe'),str(work/'verification'/variant),'0','fixtures'],check=True,timeout=60)
+comparison={}
+for variant in variants[1:]:
+    comparison[variant]={}
+    for name in ['before.bin','after.bin','heights.bin','cave_ids.bin','states.jsonl','candidates.jsonl','chunks.csv']:
+        a=(work/'verification/baseline'/name).read_bytes()
+        b=(work/'verification'/variant/name).read_bytes()
+        if a!=b: raise RuntimeError(f'{variant}/{name} differs')
+        comparison[variant][name]={'equal':True,'bytes':len(a),'sha256':hashlib.sha256(b).hexdigest()}
+for name in ['fixtures.bin','fixture_states.jsonl']:
+    a=(work/'verification/baseline_verify'/name).read_bytes()
+    b=(work/'verification/combined_verify'/name).read_bytes()
+    if a!=b: raise RuntimeError(f'{name} differs')
+    comparison[name]={'equal':True,'bytes':len(a),'sha256':hashlib.sha256(b).hexdigest()}
+(work/'verification/equivalence.json').write_text(json.dumps(comparison,indent=2))
+print('All generated blocks, candidates, cave IDs, heights, decoration states, and synthetic fixtures match.')
