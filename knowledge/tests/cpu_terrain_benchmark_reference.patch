+// Exercise mask-word carries, every XZ edge, empty biomes, non-cube supports,
+// non-cave air and targets already occupied by structures.
+static void syntheticFixtures(const std::filesystem::path& output)
+{
+    std::ofstream blocksFile(output/"fixtures.bin",std::ios::binary), statesFile(output/"fixture_states.jsonl");
+    uint64_t checked=0;
+    for (uint phase=0;phase<6;++phase) for (uint trial=0;trial<8;++trial)
+    {
+        benchmarkSeed=1738+trial;
+        std::array<std::unique_ptr<Chunk>,9> chunks;
+        for (int z=0;z<3;++z) for(int x=0;x<3;++x)
+        {
+            auto& pointer=chunks[z*3+x]; pointer=std::make_unique<Chunk>(glm::ivec2(x-2,z-2),nullptr);
+            auto& chunk=*pointer; prepare(chunk);
+            auto& blocks=chunk.*access(blocksTag{});
+            std::fill((chunk.*access(biomesTag{})).begin(),(chunk.*access(biomesTag{})).end(),Biome::PLAINS);
+            for(uint bz=0;bz<16;++bz) for(uint bx=0;bx<16;++bx)
+            {
+                blocks[Chunk::blockPosToIdx({bx,0,bz})]=Block::BEDROCK;
+                const int wx=(x-2)*16+bx,wz=(z-2)*16+bz;
+                const uint pattern=hash(wx^hash(wz));
+                for(uint y : {1u,62u,63u,64u,65u,126u,127u,128u,129u,190u,191u,192u,193u,254u,255u,256u,257u,318u,319u,320u})
+                {
+                    if ((pattern+y)%4==0) continue;
+                    const Block support=(phase%3==0)?Block::BASALT:(phase%3==1)?Block::STONE:Block::MOSS;
+                    blocks[Chunk::blockPosToIdx({bx,y,bz})]=((pattern+y)%17==0)?Block::FERN:support;
+                }
+            }
+            (chunk.*access(MasksTag{}))();
+        }
+        auto& chunk=*chunks[4];
+        for(auto& pointer:chunks) (chunk.*access(structureNeighborsTag{})).push_back(pointer.get());
+        (chunk.*access(neighborsTag{}))={chunks[5].get(),chunks[7].get(),chunks[3].get(),chunks[1].get()};
+        constexpr uint size=5,height=82,fieldSize=size*size*height;
+        std::vector<float> fields(2*fieldSize);
+        for(uint z=0;z<size;++z) for(uint x=0;x<size;++x) for(uint y=0;y<height;++y)
+        {
+            const uint i=(z*size+x)*height+y;
+            const float base=(static_cast<int>(phase%3)-1)*0.45f;
+            fields[i]=base+(phase>=3?(static_cast<int>(y%20)-10)*0.05f:0.f);
+            fields[fieldSize+i]=base+(phase>=3?(static_cast<int>((x+2*z)%5)-2)*0.12f:0.f);
+        }
+        std::vector<uint8_t> ids(256*caveMaxY,0xff);
+        metadata(chunk).noise=fields;
+        metadata(chunk).height=height;
+        auto& blocks=chunk.*access(blocksTag{});
+        for(uint z=0;z<16;++z) for(uint x=0;x<16;++x)
+        {
+            const uint col=x+16*z;
+            constexpr uint tops[]={0,63,64,127,128,319,320,511};
+            (chunk.*access(terrainTopYTag{}))[col]=tops[(x+z)%8];
+            (chunk.*access(biomesTag{}))[col]=((x+z)%4==0)?Biome::OCEAN:Biome::PLAINS;
+            const CaveBiomeNoise bias={0.01f*(static_cast<int>(x)-8),0.01f*(static_cast<int>(z)-8)};
+            ChunkGenerator::CaveNoiseColumn t(fields.data(),size,height,x,z),h(fields.data()+fieldSize,size,height,x,z);
+            metadata(chunk).bias[col]=bias;
+            for(uint y=1;y<caveMaxY;++y)
+            {
+                if(blocks[col*chunkSizeY+y]!=Block::AIR || (x+z+y)%19==0) continue;
+                const uint i=col*caveMaxY+y;
+                ids[i]=static_cast<uint8_t>(CaveBiomes::getClosestCaveBiome({t.sample(y)+bias.temperature,h.sample(y)+bias.humidity}));
+                metadata(chunk).airMask[i/64] |= uint64_t(1) << (i%64);
+                // Simulate a structure occupying original cave air after the masks were built.
+                if((x+z+y)%23==0) blocks[col*chunkSizeY+y]=Block::OAK_LOG;
+            }
+        }
+        if(caveIds(chunk)!=ids) throw std::runtime_error("fixture retained field mismatch");
+#ifdef BENCH_VERIFY
+        std::vector<uint32_t> expected;
+        for(uint z=0;z<16;++z) for(uint x=0;x<16;++x) for(uint y=1;y<caveMaxY;++y)
+        {
+            const uint col=x+16*z,blockIdx=col*chunkSizeY+y;
+            if(ids[col*caveMaxY+y]==0xff || blocks[blockIdx]!=Block::AIR) continue;
+            for(uint f=0;f<blockFaceCount;++f)
+                if(chunk.isTerrainSolidCube_WS(glm::ivec3(static_cast<int>(x)-16,y,static_cast<int>(z)-16)-blockFaceBasis(static_cast<BlockFace>(f)).normal))
+                { expected.push_back(blockIdx); break; }
+        }
+        verifiedCandidates.clear(); verifyCandidates=true;
+#endif
+        (chunk.*access(DecorateTag{}))();
+#ifdef BENCH_VERIFY
+        verifyCandidates=false;
+        if(verifiedCandidates!=expected) throw std::runtime_error("bit candidate filter differs from scalar six-face reference");
+        checked+=expected.size();
+#endif
+        blocksFile.write(reinterpret_cast<const char*>(blocks.data()),blocks.size()*sizeof(Block));
+        std::map<uint32_t,uint8_t> ordered;
+        for(auto [index,state]:chunk.*access(blockStatesTag{})) ordered[index]=state;
+        nlohmann::json items=nlohmann::json::array();
+        for(auto [index,state]:ordered) items.push_back({index,state});
+        statesFile<<items.dump()<<'\n';
+        release(chunk);
+    }
+    std::cout<<"synthetic_fixtures=48 verified_candidates="<<checked<<'\n';
+}
