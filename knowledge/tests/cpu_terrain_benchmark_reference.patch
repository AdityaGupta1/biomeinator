+++ b/build/terrain_noise_perf/build_bench.py
@@ -0,0 +1,91 @@
+import os, re, subprocess, sys
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+root = Path(__file__).resolve().parents[2]
+work = root / 'build/terrain_noise_perf'
+vc = Path('C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207')
+sdk = Path('C:/Program Files (x86)/Windows Kits/10')
+sdk_version = '10.0.26100.0'
+env = dict(os.environ)
+env['PATH'] = str(vc / 'bin/Hostx64/x64') + os.pathsep + env.get('PATH', '')
+env['TEMP'] = env['TMP'] = str(work)
+project = ET.parse(root / 'build/Biomeinator.vcxproj')
+includes = project.find('.//{*}AdditionalIncludeDirectories').text.split(';')[:-1]
+includes += [str(root / 'src/terrain'), str(vc / 'include')]
+includes += [str(sdk / 'Include' / sdk_version / name) for name in ['ucrt','shared','um','winrt','cppwinrt']]
+flags = ['/nologo','/O2','/Ob1','/MD','/Zi','/Gy','/EHsc','/std:c++20','/bigobj',
+         '/DENABLE_ASSERTS=1','/DNDEBUG','/DFASTNOISE_STATIC_LIB','/DFASTSIMD_STATIC_LIB','/DFASTSIMD_IS_RELAXED=1']
+flags += ['/I' + path for path in includes]
+objects = [root / 'build/Biomeinator.dir/RelWithDebInfo' / (name + '.obj') for name in
+           ['biome','biome_noise','cave_biome','swamp_shaping','structure_gen','decorator','thread_memory_allocator','logger']]
+libs = list((root / 'build/external/FastNoise2').rglob('*.lib'))
+libs += list((root / 'build/_deps/fastsimd-build').rglob('*.lib'))
+
+verification = r'''
+    using namespace ChunkGenerator;
+    for (const int spacing : {2, 4})
+    {
+        ThreadMemoryAllocator memory;
+        std::vector<float> whole(35 * 35 * 21), left(18 * 18 * 17), right(18 * 18 * 13);
+        const auto fill = [&](float* data, glm::ivec2 pos, unsigned size, unsigned height, int y)
+        {
+            if (spacing == 2) fillNoiseArray3D<2>(data, fnTerrainBase, pos, size, height, memory, y);
+            else fillNoiseArray3D<4>(data, fnTerrainBase, pos, size, height, memory, y);
+        };
+        fill(whole.data(), {-17,-17}, 35, 21, 3);
+        fill(left.data(), {-17,-17}, 18, 17, 5);
+        fill(right.data(), {-1,-1}, 18, 13, 7);
+        for (unsigned z=0; z<18; ++z) for (unsigned x=0; x<18; ++x)
+        {
+            for (unsigned y=0; y<17; ++y)
+                if (left[(z*18+x)*17+y] != whole[(z*35+x)*21+y+2]) throw std::runtime_error("left grid seam");
+            for (unsigned y=0; y<13; ++y)
+                if (right[(z*18+x)*13+y] != whole[((z+16)*35+x+16)*21+y+4]) throw std::runtime_error("right grid seam");
+        }
+        // Very short Y bands, including exact lattice endpoints.
+        for (int yStart=0; yStart<9; ++yStart) for (unsigned height=1; height<6; ++height)
+        {
+            std::vector<float> shortBand(16*16*height);
+            fill(shortBand.data(), {0,0}, 16, height, yStart);
+            for (float value : shortBand) if (!std::isfinite(value)) throw std::runtime_error("non-finite noise");
+        }
+    }
+'''
+
+def instrument(source):
+    source = source.replace('    const ivec2 chunkPosBlocksXZ_WS = this->chunkPos',
+                            '    auto benchStart = Clock::now();\n    const ivec2 chunkPosBlocksXZ_WS = this->chunkPos', 1)
+    for name, field in [('terrainNoise','terrain'),('caveNoiseWorley','worley'),('caveNoiseSimplex','simplex')]:
+        pattern = r'    fillNoiseArray3D(?:<[^>]+>)?\(' + name + r',[\s\S]*?;'
+        match = re.search(pattern, source)
+        assert match, name
+        before = '    timings.columns += elapsed(benchStart);\n' if field == 'terrain' else ''
+        source = source[:match.start()] + before + '    benchStart = Clock::now();\n' + match.group() + '\n    timings.' + field + ' += elapsed(benchStart);\n    benchStart = Clock::now();' + source[match.end():]
+    marker = '    const uint terrainNoiseSize = chunkSizeXZSquare * terrainNoiseHeight;'
+    source = source.replace(marker, '    timings.materials += elapsed(benchStart);\n    benchStart = Clock::now();\n' + marker, 1)
+    end = source.rfind('}')
+    source = source[:end] + '    timings.fill += elapsed(benchStart);\n' + source[end:]
+    return source
+
+support = work / 'support.obj'
+if not support.exists() or support.stat().st_mtime < (work/'support.cpp').stat().st_mtime:
+    subprocess.run([str(vc/'bin/Hostx64/x64/cl.exe'), *flags, '/c', str(work/'support.cpp'), '/Fo'+str(support), '/Fd'+str(work/'support.pdb')], cwd=root, env=env, check=True)
+
+for variant in sys.argv[1:] or ['baseline','terrain4','terrain4_caves2','terrain4_caves4']:
+    out = work / variant
+    out.mkdir(exist_ok=True)
+    source = (work/'baseline.cpp').read_text() if variant == 'baseline' else (root/'src/terrain/chunk_generator.cpp').read_text()
+    if variant != 'baseline':
+        terrain = 2 if variant == 'terrain2_caves2' else 4
+        caves = 1 if variant == 'terrain4' else 4 if variant == 'terrain4_caves4' else 2
+        source = source.replace('terrainNoiseDownsample = 4;', f'terrainNoiseDownsample = {terrain};')
+        source = source.replace('caveShapeNoiseDownsample = 2;', f'caveShapeNoiseDownsample = {caves};')
+    (out/'generator.cpp').write_text(instrument(source))
+    harness = (work/'benchmark.cpp').read_text().replace('    VERIFY_GRIDS', verification if variant != 'baseline' else '')
+    (out/'main.cpp').write_text(harness)
+    cmd = [str(vc/'bin/Hostx64/x64/cl.exe'), *flags, str(out/'main.cpp'), '/Fo'+str(out/'main.obj'), '/Fd'+str(out/'main.pdb'), '/Fe'+str(out/'benchmark.exe'),
+           str(support), *map(str,objects), *map(str,libs), '/link','/OPT:REF','/INCREMENTAL:NO',
+           '/LIBPATH:'+str(vc/'lib/x64'), '/LIBPATH:'+str(sdk/'Lib'/sdk_version/'um/x64'), '/LIBPATH:'+str(sdk/'Lib'/sdk_version/'ucrt/x64')]
+    subprocess.run(cmd, cwd=root, env=env, check=True)
+
