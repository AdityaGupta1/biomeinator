+from pathlib import Path
+import shutil
+
+original = Path(__file__).resolve().parents[1] / 'terrain_noise_perf/build_bench.py'
+setup = original.read_text().split("support = work / 'support.obj'")[0]
+setup = setup.replace("work = root / 'build/terrain_noise_perf'", "work = root / 'build/terrain_cleanup_perf'")
+exec(setup)
+
+def function(source, signature):
+    start = source.index(signature)
+    opening = source.index('{', start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        if source[end] == '{': depth += 1
+        if source[end] == '}': depth -= 1
+        end += 1
+    return source[start:end] + '\n'
+
+for variant in sys.argv[1:] or ['baseline','surface','directional','combined']:
+    out = work / variant
+    terrain = out / 'terrain'
+    terrain.mkdir(parents=True, exist_ok=True)
+    for header in (root/'src/terrain').rglob('*.h'):
+        target = terrain / header.relative_to(root/'src/terrain')
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(header, target)
+    case = variant.removesuffix('_verify')
+    source_root = root/'src/terrain' if case=='combined' else work/(case+'_sources')
+    shutil.copyfile(source_root/'chunk.h', terrain/'chunk.h')
+    source = (source_root/'chunk_generator.cpp').read_text()
+    (terrain/'generator.cpp').write_text(instrument(source))
+    chunk_source = (source_root/'chunk.cpp').read_text()
+    methods = '#include "chunk.h"\n#include "cave_biome_noise.h"\n#include "settings_manager.h"\n#include "util/rng.h"\n#include <bit>\nusing namespace glm;\n'
+    start = chunk_source.index('namespace\n{')
+    end = chunk_source.index('} // namespace',start) + len('} // namespace')
+    methods += chunk_source[start:end] + '\n'
+    for signature in ['void Chunk::buildTerrainAirMask(', 'bool Chunk::getTerrainMaskBit_WS(',
+                      'bool Chunk::isTerrainAir_WS(', 'bool Chunk::isTerrainSolidCube_WS(',
+                      'void Chunk::runStructuresAndDecoratorPass(', 'uint32_t Chunk::blockPosToIdx(',
+                      'uint32_t Chunk::blockPosXZToIdx(']:
+        methods += function(chunk_source,signature)
+    # Clock the existing structure and decorator portions independently, without changing work.
+    marker = '    const uint worldSeed = SettingsManager::getWorldSeed();'
+    methods = methods.replace('void Chunk::runStructuresAndDecoratorPass()\n{',
+        'void Chunk::runStructuresAndDecoratorPass()\n{\n    auto passStart = Clock::now();')
+    methods = methods.replace(marker,'    timings.structures += elapsed(passStart);\n    passStart = Clock::now();\n'+marker)
+    next_method = methods.index('uint32_t Chunk::blockPosToIdx(')
+    closing = methods.rfind('}', 0, next_method)
+    methods = methods[:closing] + '    timings.decorators += elapsed(passStart);\n' + methods[closing:]
+    if variant.endswith('_verify'):
+        marker='const CaveBiome caveBiome = CaveBiomes::getClosestCaveBiome({'
+        methods=methods.replace(marker,'if (verifyCandidates) verifiedCandidates.push_back(blockIdx);\n                    '+marker)
+    if variant.endswith('_verify') and case in ['directional','combined']:
+        marker='if (!(supportByFace[faceIdx] & candidateBit)) continue;'
+        hook='if (verifyCandidates)\n                        {\n                            const glm::ivec3 checkPos(chunkOriginXZ_WS.x + blockX, blockY, chunkOriginXZ_WS.y + blockZ);\n                            const bool expected = this->isTerrainSolidCube_WS(checkPos - blockFaceBasis(static_cast<BlockFace>(faceIdx)).normal);\n                            if (expected != bool(supportByFace[faceIdx] & candidateBit))\n                                throw std::runtime_error("directional support mask mismatch");\n                        }\n                        '
+        assert marker in methods
+        methods=methods.replace(marker,hook+marker)
+    (terrain/'chunk_methods.cpp').write_text(methods)
+    (out/'main.cpp').write_text((work/'benchmark.cpp').read_text().replace('VERIFY_GRIDS',verification))
+    shutil.copyfile(work/'fixtures.cpp',out/'fixtures.cpp')
+    compile_flags = flags + ['/I'+str(out),'/I'+str(terrain),'/I'+str(terrain/'structure')]
+    # Put the mirrored headers before the real src root to isolate baseline Chunk layout.
+    compile_flags = [f for f in compile_flags if not f.startswith('/I')] + ['/I'+str(out),'/I'+str(terrain),'/I'+str(terrain/'structure')] + [f for f in flags if f.startswith('/I')]
+    compile_flags += ['/DBENCH_GROUPED=1'] if case=='combined' else []
+    compile_flags += ['/DBENCH_VERIFY=1'] if variant.endswith('_verify') else []
+    extra_objects = []
+    for name in ['structure','cave_structure']:
+        src = terrain/'structure'/f'{name}.cpp'
+        shutil.copyfile(root/'src/terrain/structure'/f'{name}.cpp', src)
+        obj = out/f'{name}.obj'
+        subprocess.run([str(vc/'bin/Hostx64/x64/cl.exe'),*compile_flags,'/c',str(src),'/Fo'+str(obj),'/Fd'+str(out/'compile.pdb')],cwd=root,env=env,check=True)
+        extra_objects.append(obj)
+    support = out/'support.obj'
+    subprocess.run([str(vc/'bin/Hostx64/x64/cl.exe'),*compile_flags,'/c',str(work/'support.cpp'),'/Fo'+str(support),'/Fd'+str(out/'compile.pdb')],cwd=root,env=env,check=True)
+    cmd = [str(vc/'bin/Hostx64/x64/cl.exe'),*compile_flags,str(out/'main.cpp'),'/Fo'+str(out/'main.obj'),'/Fd'+str(out/'main.pdb'),'/Fe'+str(out/'benchmark.exe'),
+           str(support),*map(str,extra_objects),*map(str,objects),*map(str,libs),'/link','/OPT:REF','/INCREMENTAL:NO',
+           '/LIBPATH:'+str(vc/'lib/x64'),'/LIBPATH:'+str(sdk/'Lib'/sdk_version/'um/x64'),'/LIBPATH:'+str(sdk/'Lib'/sdk_version/'ucrt/x64')]
+    subprocess.run(cmd,cwd=root,env=env,check=True)
diff --git a/build/terrain_cleanup_perf/run_bench.py b/build/terrain_cleanup_perf/run_bench.py
