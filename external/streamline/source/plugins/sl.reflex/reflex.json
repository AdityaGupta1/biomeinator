// These are the hooks we need to do whatever our plugin is trying to do
{
    "id" : 3,
    "priority" : 100,
    "name" : "sl.reflex",
    "namespace" : "reflex",
    "required_plugins" : ["sl.common"],
    "incompatible_plugins" : ["sl.latency"],
    "rhi" : ["d3d11", "d3d12", "vk"],
    "hooks" :
    [
        {
            "class": "Vulkan",
            "target" : "CreateSwapchainKHR",
            "replacement" : "slHookVkCreateSwapchainKHRBefore",
            "base" : "before"
        },
        {
            "class": "Vulkan",
            "target" : "CreateSwapchainKHR",
            "replacement" : "slHookVkCreateSwapchainKHRAfter",
            "base" : "after"
        },
        {
            "class": "Vulkan",
            "target" : "DestroySwapchainKHR",
            "replacement" : "slHookVkDestroySwapchainKHRBefore",
            "base" : "before"
        }
    ]
}